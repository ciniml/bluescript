# M5Stack CoreS3 / CoreS3 SE: 16 MB flash, 8 MB quad PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/m5stack-cores3/partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="boards/m5stack-cores3/partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
